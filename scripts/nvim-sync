#!/usr/bin/env bash

# nvim-sync: A safe, hash-based sync tool for Neovim configuration.
# Supports macOS and Linux (Arch).

set -euo pipefail

# --- Configuration ---
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_NVIM="$REPO_ROOT/nvim"
LOCAL_NVIM="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"

# Files to include in sync (relative to nvim root)
INCLUDES=(
    "init.lua"
    "lazy-lock.json"
    ".luarc.json"
)

# --- Helpers ---

log() { echo -e "\033[1;34m[INFO]\033[0m $*"; }
warn() { echo -e "\033[1;33m[WARN]\033[0m $*"; }
error() { echo -e "\033[1;31m[ERROR]\033[0m $*" >&2; exit 1; }
success() { echo -e "\033[1;32m[SUCCESS]\033[0m $*"; }

# Cross-platform hash function
get_hash() {
    local file="$1"
    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS md5 -q <file>
        md5 -q "$file"
    else
        # Linux md5sum <file>
        md5sum "$file" | cut -d' ' -f1
    fi
}

show_help() {
    cat <<EOF
Usage: $(basename "$0") [command] [options]

Commands:
  status         Compare repo and local config (default).
  deploy         Copy from repo to ~/.config/nvim.
  collect        Copy from ~/.config/nvim to repo.

Options:
  --apply        Required to actually perform modifications.
  --dry-run      Show actions without applying them (default for deploy/collect).
  --help         Show this message.

EOF
}

# --- Core Logic ---

compare_files() {
    local cmd="${1:-status}"
    local apply="${2:-false}"

    if [[ ! -d "$REPO_NVIM" ]]; then
        error "Repository nvim directory not found at $REPO_NVIM"
    fi

    log "Comparing $REPO_NVIM <-> $LOCAL_NVIM"
    
    # 1. Gather all candidate files
    local files=()
    for inc in "${INCLUDES[@]}"; do
        files+=("$inc")
    done

    # 2. Find all .lua and .scm files recursively in REPO
    while IFS= read -r -d '' f; do
        # Strip the REPO_NVIM prefix to get the relative path
        files+=("${f#$REPO_NVIM/}")
    done < <(find "$REPO_NVIM" -name ".*" -prune -o -type f \( -name "*.lua" -o -name "*.scm" \) -print0)

    # 3. Find all .lua and .scm files recursively in LOCAL
    if [[ -d "$LOCAL_NVIM" ]]; then
        while IFS= read -r -d '' f; do
            files+=("${f#$LOCAL_NVIM/}")
        done < <(find "$LOCAL_NVIM" -name ".*" -prune -o -type f \( -name "*.lua" -o -name "*.scm" \) -print0)
    fi

    # 4. Process files (unique list)
    local diff_count=0
    # Use null-delimited sort and read for 100% path safety.
    # macOS 'sort' supports -z.
    while IFS= read -r -d '' f; do
        local r_file="$REPO_NVIM/$f"
        local l_file="$LOCAL_NVIM/$f"
        
        local r_exists=false
        [[ -f "$r_file" ]] && r_exists=true
        
        local l_exists=false
        [[ -f "$l_file" ]] && l_exists=true

        if $r_exists && $l_exists; then
            local r_hash
            if ! r_hash=$(get_hash "$r_file"); then
                warn "Could not calculate hash for $r_file. Skipping."
                continue
            fi
            
            local l_hash
            if ! l_hash=$(get_hash "$l_file"); then
                warn "Could not calculate hash for $l_file. Skipping."
                continue
            fi

            if [[ "$r_hash" != "$l_hash" ]]; then
                echo -e "\033[1;33m[DIFF]\033[0m $f"
                diff_count=$((diff_count + 1))
                if [[ "$cmd" != "status" ]]; then
                    sync_file "$cmd" "$f" "$apply"
                fi
            fi
        elif $r_exists && ! $l_exists; then
            echo -e "\033[1;36m[REPO-ONLY]\033[0m $f"
            diff_count=$((diff_count + 1))
            if [[ "$cmd" == "deploy" ]]; then
                sync_file "deploy" "$f" "$apply"
            fi
        elif ! $r_exists && $l_exists; then
            echo -e "\033[1;35m[LOCAL-ONLY]\033[0m $f"
            diff_count=$((diff_count + 1))
            if [[ "$cmd" == "collect" ]]; then
                sync_file "collect" "$f" "$apply"
            fi
        fi
    done < <(printf "%s\0" "${files[@]}" | sort -z -u)

    if [[ $diff_count -eq 0 ]]; then
        success "Configurations are perfectly in sync."
    else
        log "Found $diff_count files out of sync."
        if [[ "$apply" == "false" && "$cmd" != "status" ]]; then
            warn "No changes applied. Use --apply to proceed."
        fi
    fi
}

sync_file() {
    local mode="$1"
    local rel_path="$2"
    local apply="$3"

    local src=""
    local dst=""

    if [[ "$mode" == "deploy" ]]; then
        src="$REPO_NVIM/$rel_path"
        dst="$LOCAL_NVIM/$rel_path"
    else
        src="$LOCAL_NVIM/$rel_path"
        dst="$REPO_NVIM/$rel_path"
    fi

    if [[ "$apply" == "true" ]]; then
        log "Syncing: $rel_path"
        mkdir -p "$(dirname "$dst")"
        # -a: archive mode, preserves permissions, ownership, and DOES NOT dereference symlinks.
        cp -a "$src" "$dst" || error "Failed to copy $rel_path. Check permissions/disk space."
    else
        echo -e "  \033[0;90m-> Would copy $src to $dst\033[0m"
    fi
}

# --- Argument Parsing ---

CMD="status"
APPLY=false
APPLY_SET=false
DRY_RUN_SET=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        status|deploy|collect)
            CMD="$1"
            shift
            ;;
        --apply)
            if $DRY_RUN_SET; then error "Cannot use --apply and --dry-run together."; fi
            APPLY=true
            APPLY_SET=true
            shift
            ;;
        --dry-run)
            if $APPLY_SET; then error "Cannot use --apply and --dry-run together."; fi
            APPLY=false
            DRY_RUN_SET=true
            shift
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            error "Unknown argument: $1"
            ;;
    esac
done

# --- Main ---

case "$CMD" in
    status)
        compare_files "status" "false"
        ;;
    deploy|collect)
        compare_files "$CMD" "$APPLY"
        ;;
esac
